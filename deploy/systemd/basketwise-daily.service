[Unit]
Description=BasketWise daily crawl, build, publish and Supabase sync
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/srv/basketwise/basketwise.env
ExecStart=/home/ubuntu/basketwise/deploy/scripts/daily.sh
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
