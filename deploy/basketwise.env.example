# Copy to /srv/basketwise/basketwise.env on the server, fill in, then: chmod 600
# Read by deploy/scripts/up.sh (containers) and the systemd daily job.

# Public hostname: a Route 53 A record pointing at the instance's Elastic IP.
# No domain? Use sslip.io: Elastic IP 3.25.10.7 -> 3-25-10-7.sslip.io
DOMAIN=basketwise.aryannaveen.com

# Supabase: only for live crawling (price history across days). Leave both BLANK
# in snapshot mode -- a placeholder value makes every product page wait on a
# Supabase timeout. When used: Project Settings -> API, the SECRET (service-role)
# key, e.g. SUPABASE_URL=https://<ref>.supabase.co  SUPABASE_SECRET_KEY=sb_secret_...
# Server-side only. Never put it in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional, live crawling only: https://healthchecks.io ping URL; emails you if a daily run fails or is missed.
HEALTHCHECK_URL=

# Frontend and API share one origin, so CORS only matters for other sites.
BASKETWISE_CORS=*
