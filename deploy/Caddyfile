{$DOMAIN} {
	encode zstd gzip

	# API: strip the /api prefix and hand off to the FastAPI container.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Frontend: static files, falling back to index.html for client-side routes
	# (/browse, /product/:id, ...).
	handle {
		root * /srv/www
		# Vite fingerprints /assets/*, so those never change; everything else
		# (index.html for every route) must revalidate so a new deploy shows up.
		@hashed path /assets/*
		@unhashed not path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
